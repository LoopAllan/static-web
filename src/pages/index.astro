<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>TossBox · 地圖優先 Prototype</title>
<meta name="description" content="TossBox 地圖優先 PlaceResolution 收藏決策流程 prototype。" />
<style>
:root{--ink:#1c2824;--muted:#6e7773;--paper:#faf8f2;--panel:#fffdf8;--line:#e9e4d9;--lime:#d8f26b;--mint:#bceee4;--pink:#ffa8ab;--orange:#ffca75;--violet:#c8b8ff;--shadow:0 14px 40px rgba(40,47,42,.13)}
*{box-sizing:border-box}body{margin:0;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans TC",sans-serif;color:var(--ink);background:#e4eee8;overflow:hidden}.app{height:100dvh;position:relative;background:#dce8df}.map{position:absolute;inset:0;overflow:hidden;background:linear-gradient(130deg,#d9eadf,#e9efdc 57%,#cfdfd5)}
.map:before,.map:after{content:"";position:absolute;inset:-12%;background:repeating-linear-gradient(23deg,transparent 0 76px,rgba(255,255,252,.78) 77px 84px,transparent 85px 160px),repeating-linear-gradient(112deg,transparent 0 95px,rgba(255,255,255,.65) 96px 104px,transparent 105px 190px);transform:rotate(-4deg);opacity:.92}.river{position:absolute;left:23%;top:-10%;height:125%;width:74px;background:#bce0e2;border:9px solid rgba(255,255,255,.35);transform:rotate(24deg);border-radius:50%}.district{position:absolute;border-radius:50%;background:rgba(168,221,191,.45);filter:blur(1px)}.d1{width:280px;height:160px;top:32%;left:20%}.d2{width:210px;height:150px;top:10%;right:7%}.d3{width:270px;height:160px;bottom:-4%;left:43%}.label{position:absolute;color:#61706a;font-size:12px;font-weight:800;letter-spacing:.08em}.label.one{top:21%;left:12%}.label.two{top:22%;right:16%}.label.three{bottom:26%;right:12%}.label.four{bottom:34%;left:27%}
.topbar{position:absolute;top:18px;left:18px;right:18px;display:flex;gap:10px;align-items:center;z-index:10}.brand{width:46px;height:46px;border-radius:16px;background:var(--ink);color:#fff;display:grid;place-items:center;font-weight:900;box-shadow:var(--shadow);letter-spacing:-.08em}.search{height:48px;flex:1;border-radius:16px;border:1px solid rgba(255,255,255,.8);background:rgba(255,253,248,.94);display:flex;align-items:center;gap:10px;padding:0 15px;box-shadow:0 8px 25px rgba(46,58,49,.12);font-size:14px;font-weight:700}.search svg{width:19px;color:#647069}.search small{margin-left:auto;color:var(--muted);font-weight:600}.avatar{height:46px;width:46px;border-radius:16px;border:1px solid rgba(255,255,255,.9);background:linear-gradient(135deg,#ffc4a9,#f5dfb1);box-shadow:var(--shadow);display:grid;place-items:center;font-size:20px}
.controls{position:absolute;left:18px;right:18px;top:78px;z-index:9;display:flex;gap:8px;overflow:auto;padding-bottom:4px;scrollbar-width:none}.chip{border:1px solid rgba(255,255,255,.9);background:rgba(255,253,248,.93);color:#53615a;border-radius:999px;height:36px;padding:0 14px;white-space:nowrap;font-weight:800;font-size:13px;display:inline-flex;align-items:center;gap:7px;box-shadow:0 5px 18px rgba(45,56,49,.08);cursor:pointer}.chip.active{background:var(--ink);color:#fff;border-color:var(--ink)}.chip .dot{width:8px;height:8px;border-radius:50%;background:var(--lime)}
.locate{position:absolute;right:18px;top:130px;width:47px;height:47px;border:0;border-radius:16px;background:var(--panel);box-shadow:var(--shadow);font-size:20px;cursor:pointer}.place-pin{position:absolute;z-index:5;transform:translate(-50%,-100%);border:0;background:transparent;cursor:pointer;padding:0}.pin-dot{width:42px;height:42px;border:3px solid #fff;border-radius:17px 17px 17px 4px;transform:rotate(-45deg);box-shadow:0 8px 16px rgba(46,51,41,.22);display:grid;place-items:center}.pin-dot span{transform:rotate(45deg);font-size:17px}.pin-dot.mint{background:var(--mint)}.pin-dot.pink{background:var(--pink)}.pin-dot.orange{background:var(--orange)}.pin-dot.violet{background:var(--violet)}.place-pin.selected .pin-dot{outline:4px solid rgba(28,40,36,.22);transform:rotate(-45deg) scale(1.15)}.pin-note{position:absolute;top:48px;left:15px;transform:translateX(-25%);padding:7px 9px;border-radius:10px;background:#fffdf8;box-shadow:0 5px 14px rgba(0,0,0,.12);white-space:nowrap;font-size:12px;font-weight:900;opacity:0;transition:.2s}.place-pin.selected .pin-note{opacity:1}
.status{position:absolute;top:143px;left:18px;z-index:4;padding:9px 11px;border-radius:12px;background:rgba(255,253,248,.88);font-size:12px;font-weight:800;color:#5c6861;box-shadow:0 4px 14px rgba(45,56,49,.08)}.status b{color:#2f6a58}
.sheet{position:absolute;z-index:20;bottom:0;left:0;right:0;background:rgba(255,253,248,.98);border-radius:26px 26px 0 0;box-shadow:0 -12px 45px rgba(34,48,39,.18);padding:9px 18px max(18px,env(safe-area-inset-bottom));max-height:56dvh;transition:transform .28s ease}.grab{width:42px;height:5px;border-radius:99px;background:#dad5ca;margin:0 auto 14px}.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.eyebrow{font-size:12px;font-weight:900;letter-spacing:.08em;color:#728078}.title{font-size:21px;font-weight:900;letter-spacing:-.035em;margin-top:2px}.count{font-size:12px;border-radius:99px;background:#ebf1df;padding:7px 10px;color:#54603e;font-weight:900}.cards{display:flex;gap:11px;overflow-x:auto;padding:1px 0 2px;scrollbar-width:none}.card{min-width:260px;width:260px;border:1px solid var(--line);background:white;border-radius:18px;padding:10px;display:grid;grid-template-columns:74px 1fr;gap:11px;cursor:pointer;transition:.18s}.card:hover,.card.active{border-color:#a9c486;box-shadow:0 8px 20px rgba(63,86,57,.1);transform:translateY(-2px)}.thumb{height:74px;border-radius:13px;position:relative;overflow:hidden;background:linear-gradient(145deg,#f6c59c,#cc7b59 46%,#844638)}.thumb.coffee{background:radial-gradient(circle at 62% 38%,#f7d3a4 0 10%,transparent 11%),linear-gradient(120deg,#a65932,#efaa67 52%,#51301e)}.thumb.sweet{background:radial-gradient(circle at 35% 30%,#fff2d3 0 11%,transparent 12%),radial-gradient(circle at 63% 55%,#e88486 0 16%,transparent 17%),linear-gradient(130deg,#fbcbcb,#f4a2a6)}.thumb.walk{background:linear-gradient(145deg,#7eb78c,#d9e6ad 47%,#6fa0a0)}.thumb:after{content:"來源貼文";position:absolute;bottom:5px;left:5px;border-radius:6px;background:rgba(24,35,28,.7);padding:3px 5px;color:#fff;font-size:8px;font-weight:800}.card h3{margin:1px 0 5px;font-size:15px;line-height:1.2;letter-spacing:-.02em}.card p{margin:0;color:var(--muted);font-size:12px;line-height:1.35}.meta{margin-top:6px;display:flex;gap:5px;align-items:center;color:#59665e;font-size:11px;font-weight:800}.meta strong{color:#2d6959}.fresh{margin-left:auto;color:#6f766c;font-weight:700}.sheet.expanded{max-height:81dvh}.sheet.expanded .cards{display:grid;grid-template-columns:1fr 1fr;max-height:52dvh;overflow:auto;padding:3px}.sheet.expanded .card{width:auto;min-width:0}.expand{border:0;background:transparent;font-size:13px;font-weight:900;color:#47735f;cursor:pointer}
.detail{position:absolute;z-index:40;inset:0;background:rgba(20,27,24,.38);display:none;align-items:flex-end}.detail.open{display:flex}.detail-panel{width:100%;max-height:88dvh;overflow:auto;background:#fffdf8;border-radius:28px 28px 0 0;box-shadow:0 -10px 50px rgba(0,0,0,.22);padding:10px 18px 34px}.hero{height:200px;border-radius:19px;background:linear-gradient(135deg,#d8834d 0 32%,#f1c582 33% 61%,#793e2d 62%);position:relative;overflow:hidden}.hero:before{content:"";position:absolute;width:180px;height:180px;border:20px solid rgba(255,232,192,.72);border-radius:50%;bottom:-105px;right:-20px}.hero:after{content:"地點照片\A 模擬資料";white-space:pre;position:absolute;bottom:13px;left:13px;padding:6px 8px;background:rgba(22,30,25,.72);border-radius:8px;color:#fff;font-size:11px;font-weight:800}.close{position:absolute;right:30px;margin-top:11px;width:36px;height:36px;border:0;border-radius:12px;background:rgba(255,253,248,.94);font-size:21px;z-index:2;cursor:pointer}.detail-top{padding:16px 1px 8px}.detail-title{font-size:27px;letter-spacing:-.05em;margin:4px 0 7px}.detail-sub{color:var(--muted);font-size:14px;margin:0}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:17px 0}.fact{border-radius:13px;background:#f3f1eb;padding:10px;font-size:12px;color:#617068}.fact b{display:block;color:var(--ink);font-size:14px;margin-bottom:3px}.section{border-top:1px solid var(--line);padding:15px 0}.section h4{margin:0 0 8px;font-size:14px}.source{display:flex;gap:10px;align-items:center;padding:10px;border-radius:14px;background:#fff5eb}.source i{font-style:normal;width:35px;height:35px;border-radius:11px;background:linear-gradient(135deg,#fbb98b,#f19a93);display:grid;place-items:center}.source p{margin:0;font-size:12px;line-height:1.45;color:#56645c}.source strong{color:var(--ink)}.candidate-toggle{border:0;background:#edf4e9;color:#417151;border-radius:10px;padding:9px 11px;font-weight:900;font-size:12px;cursor:pointer}.candidate-list{display:none;margin-top:9px;font-size:12px;color:#5d6b63;line-height:1.7}.candidate-list.show{display:block}.actions{display:flex;gap:9px;position:sticky;bottom:-34px;background:#fffdf8;padding-top:12px}.button{border:0;border-radius:14px;padding:14px 15px;font-size:14px;font-weight:900;cursor:pointer}.button.primary{flex:1;background:var(--ink);color:white}.button.secondary{background:#ecf1e7;color:#355d49}.toast{position:absolute;z-index:99;top:128px;left:50%;transform:translate(-50%,-15px);opacity:0;pointer-events:none;background:#1e2d27;color:#fff;border-radius:12px;padding:11px 14px;font-size:13px;font-weight:800;transition:.25s;box-shadow:var(--shadow)}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(min-width:760px){.topbar{left:28px;right:28px;top:24px}.controls{left:28px;right:auto;top:86px}.locate{right:30px;top:110px}.status{left:30px;top:150px}.sheet{left:28px;bottom:28px;width:390px;right:auto;border-radius:24px;max-height:calc(100dvh - 190px);padding-bottom:16px}.cards{display:grid;overflow:auto;max-height:calc(100dvh - 300px);padding-right:4px}.card{width:auto;min-width:0}.expand{display:none}.detail{align-items:center;justify-content:flex-end;background:rgba(20,27,24,.18);pointer-events:none}.detail-panel{pointer-events:auto;margin-right:28px;width:430px;border-radius:24px;max-height:calc(100dvh - 56px);padding-bottom:18px}.actions{bottom:-18px}.hero{height:190px}}
</style>
</head>
<body>
<main class="app" aria-label="TossBox prototype">
  <div class="map" aria-label="模擬地圖"><div class="river"></div><div class="district d1"></div><div class="district d2"></div><div class="district d3"></div><span class="label one">中山</span><span class="label two">松山</span><span class="label three">大安</span><span class="label four">萬華</span></div>
  <div class="toast" id="toast">這是 prototype：不會開啟真實導航</div>
  <header class="topbar"><div class="brand" aria-label="TossBox">tb</div><button class="search" id="searchBtn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="11" cy="11" r="6"></circle><path d="m20 20-4.2-4.2"></path></svg><span id="searchText">台北車站附近</span><small>搜尋目的地</small></button><div class="avatar" aria-hidden="true">🌿</div></header>
  <nav class="controls" aria-label="篩選"><button class="chip active" data-filter="all"><span class="dot"></span>全部</button><button class="chip" data-filter="food">吃東西</button><button class="chip" data-filter="coffee">咖啡甜點</button><button class="chip" data-filter="walk">走走逛逛</button></nav>
  <div class="status">📍 <b>目前附近</b> · 地圖移動後可重新搜尋</div><button class="locate" id="locate" aria-label="回到目前位置">⌖</button>
  <button class="place-pin selected" style="left:49%;top:49%" data-id="nien"><span class="pin-dot mint"><span>☕</span></span><span class="pin-note">念念不忘咖啡</span></button>
  <button class="place-pin" style="left:66%;top:38%" data-id="tiger"><span class="pin-dot pink"><span>🍜</span></span><span class="pin-note">虎記麵舖</span></button>
  <button class="place-pin" style="left:34%;top:58%" data-id="milk"><span class="pin-dot orange"><span>🍮</span></span><span class="pin-note">牛奶糖研究室</span></button>
  <button class="place-pin" style="left:72%;top:65%" data-id="garden"><span class="pin-dot violet"><span>🌳</span></span><span class="pin-note">小島花園</span></button>
  <section class="sheet" id="sheet" aria-label="附近的確認地點"><div class="grab"></div><div class="sheet-head"><div><div class="eyebrow" id="sheetEyebrow">台北車站附近</div><div class="title" id="sheetTitle">先選一個，出發吧</div></div><div><span class="count" id="count">4 個地點</span><button class="expand" id="expand">展開全部</button></div></div><div class="cards" id="cards"></div></section>
  <section class="detail" id="detail" aria-modal="true" role="dialog" aria-label="地點詳情"><div class="detail-panel"><button class="close" id="close" aria-label="關閉">×</button><div class="hero" id="hero"></div><div class="detail-top"><div class="eyebrow" id="detailType">咖啡甜點 · 已確認地點</div><h1 class="detail-title" id="detailName">念念不忘咖啡</h1><p class="detail-sub" id="detailAddress">中山區赤峰街 47 巷 8 號</p></div><div class="facts"><div class="fact"><b id="detailRating">4.6 ★</b><span id="detailReviews">1,248</span> 則評價</div><div class="fact"><b id="detailPrice">$$</b>價格級別</div><div class="fact"><b id="detailFresh">22 分鐘前</b>資料查詢</div></div><div class="section"><h4>這筆收藏從哪裡來？</h4><div class="source"><i>◒</i><p><strong id="sourceTitle">午後散步的 3 家咖啡廳</strong><br><span id="sourceText">「窗邊的光線很好，適合慢慢喝一杯。」</span></p></div></div><div class="section"><button class="candidate-toggle" id="candidates">查看其他辨識候選 <span>⌄</span></button><div class="candidate-list" id="candidateList">這些是同一 PlaceResolution 的替代辨識候選，尚未確認，不會出現在主地圖或清單中。<br>・念念不忘咖啡（赤峰街）<br>・念念不忘咖啡（民生店）</div></div><div class="actions"><button class="button secondary" id="sourceButton">看來源</button><button class="button primary" id="navigate">在 Google Maps 開啟 ↗</button></div></div></section>
</main>
<script is:inline>
// @ts-nocheck
const places=[
{id:'nien',name:'念念不忘咖啡',kind:'coffee',type:'咖啡甜點',address:'中山區赤峰街 47 巷 8 號',rating:'4.6 ★',reviews:'1,248',price:'$$',fresh:'22 分鐘前',emoji:'☕',thumb:'coffee',source:'午後散步的 3 家咖啡廳',quote:'「窗邊的光線很好，適合慢慢喝一杯。」',hero:'linear-gradient(135deg,#d8834d 0 32%,#f1c582 33% 61%,#793e2d 62%)'},
{id:'tiger',name:'虎記麵舖',kind:'food',type:'吃東西',address:'大同區承德路一段 42 巷 15 號',rating:'4.4 ★',reviews:'876',price:'$',fresh:'2 小時前',emoji:'🍜',thumb:'',source:'下班後的一人晚餐清單',quote:'「湯頭乾淨，晚一點去也不會太有壓力。」',hero:'linear-gradient(135deg,#7a3d25 0 28%,#df7b3f 29% 57%,#f4c274 58%)'},
{id:'milk',name:'牛奶糖研究室',kind:'coffee',type:'咖啡甜點',address:'萬華區成都路 93 號',rating:'4.7 ★',reviews:'514',price:'$$',fresh:'昨天',emoji:'🍮',thumb:'sweet',source:'西門散步時想再去的甜點店',quote:'「焦糖布丁和音樂都很對味。」',hero:'linear-gradient(135deg,#f5c7ca 0 36%,#ef8f95 37% 66%,#fff0d2 67%)'},
{id:'garden',name:'小島花園',kind:'walk',type:'走走逛逛',address:'大安區新生南路三段 56 巷 4 號',rating:'4.5 ★',reviews:'326',price:'免費',fresh:'需更新',emoji:'🌳',thumb:'walk',source:'週末不排滿的散步地圖',quote:'「想留一點空白，就往這裡走。」',hero:'linear-gradient(135deg,#72a47d 0 35%,#d7e4ac 36% 63%,#6b9899 64%)'}];
let current='nien',filter='all';const cards=document.getElementById('cards');const detail=document.getElementById('detail');
function render(){const items=places.filter(p=>filter==='all'||p.kind===filter);cards.innerHTML=items.map(p=>`<article class="card ${p.id===current?'active':''}" data-id="${p.id}"><div class="thumb ${p.thumb}"></div><div><h3>${p.name}</h3><p>${p.address}</p><div class="meta"><strong>${p.rating}</strong><span>· ${p.type}</span><span class="fresh">${p.fresh}</span></div></div></article>`).join('');document.getElementById('count').textContent=`${items.length} 個地點`;document.querySelectorAll('.card').forEach(el=>el.onclick=()=>select(el.dataset.id,true));document.querySelectorAll('.place-pin').forEach(el=>{const p=places.find(x=>x.id===el.dataset.id);el.style.display=(filter==='all'||p.kind===filter)?'block':'none';el.classList.toggle('selected',el.dataset.id===current)});}
function select(id,open){current=id;const p=places.find(x=>x.id===id);render();if(open){document.getElementById('detailName').textContent=p.name;document.getElementById('detailType').textContent=`${p.type} · 已確認地點`;document.getElementById('detailAddress').textContent=p.address;document.getElementById('detailRating').textContent=p.rating;document.getElementById('detailReviews').textContent=p.reviews;document.getElementById('detailPrice').textContent=p.price;document.getElementById('detailFresh').textContent=p.fresh;document.getElementById('sourceTitle').textContent=p.source;document.getElementById('sourceText').textContent=p.quote;document.getElementById('hero').style.background=p.hero;detail.classList.add('open')}}
document.querySelectorAll('.place-pin').forEach(el=>el.onclick=()=>select(el.dataset.id,true));document.querySelectorAll('.chip').forEach(el=>el.onclick=()=>{filter=el.dataset.filter;document.querySelectorAll('.chip').forEach(c=>c.classList.toggle('active',c===el));const available=places.find(p=>filter==='all'||p.kind===filter);if(!places.filter(p=>filter==='all'||p.kind===filter).some(p=>p.id===current))current=available.id;render()});
document.getElementById('close').onclick=()=>detail.classList.remove('open');detail.onclick=e=>{if(e.target===detail)detail.classList.remove('open')};document.getElementById('expand').onclick=()=>{const s=document.getElementById('sheet');s.classList.toggle('expanded');document.getElementById('expand').textContent=s.classList.contains('expanded')?'收合地點':'展開全部'};document.getElementById('candidates').onclick=()=>document.getElementById('candidateList').classList.toggle('show');
function toast(message){const t=document.getElementById('toast');t.textContent=message;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600)}document.getElementById('navigate').onclick=()=>toast('這是 prototype：不會開啟真實導航');document.getElementById('sourceButton').onclick=()=>toast('這裡會開啟該 PlaceResolution 追溯到的來源貼文');document.getElementById('locate').onclick=()=>toast('已回到目前附近（模擬）');document.getElementById('searchBtn').onclick=()=>{const target=document.getElementById('searchText');const changed=target.textContent==='台北車站附近';target.textContent=changed?'松山文創園區':'台北車站附近';document.getElementById('sheetEyebrow').textContent=target.textContent;toast(changed?'已移動到目的地（模擬）':'已回到台北車站附近（模擬）')};render();
</script>
</body></html>